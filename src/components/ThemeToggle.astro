<button type="button" class="theme-toggle" data-theme-toggle aria-label="切换深色模式">
	<span class="sr-only">切换深色模式</span>
	<svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6 6l1.5 1.5M16.5 16.5 18 18M18 6l-1.5 1.5M7.5 16.5 6 18"></path>
	</svg>
	<svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<path d="M19 14.5A7.5 7.5 0 1 1 9.5 5 6 6 0 0 0 19 14.5z"></path>
	</svg>
</button>

<style>
	.icon-moon { display: none; }
	:global(html[data-theme='dark']) .icon-sun { display: none; }
	:global(html[data-theme='dark']) .icon-moon { display: block; }
</style>

<script>
	function apply(theme: string) {
		document.documentElement.dataset.theme = theme;
		localStorage.setItem('indieai-theme', theme);
		const button = document.querySelector('[data-theme-toggle]');
		if (button) {
			button.setAttribute('aria-label', theme === 'dark' ? '切换浅色模式' : '切换深色模式');
		}
	}

	document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			apply(next);
		});
	});
</script>
